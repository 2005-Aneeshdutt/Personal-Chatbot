{
  "paths": {
    "entity_extraction": "data/entity_extraction.json",
    "intent_model": "models/intent_model.pkl",
    "intent_train_data": "data_splits/train.json",
    "intent_train_sources": [
      "data_splits/train.json",
      "data_splits/dev.json"
    ],
    "knowledge_base_dir": "data",
    "kb_files": {
      "timetable": "timetable.json",
      "exams": "exams.json",
      "holidays": "holidays.json",
      "academic_rules": "academic_rules.json"
    },
    "llm_system_prompt_file": "config/prompts/llm_system.txt",
    "ui_strings": "config/ui_strings.json"
  },
  "intent": {
    "min_confidence": 0.2,
    "routing_min_confidence": 0.3,
    "context_recovery_confidence": 0.5
  },
  "intent_model_training": {
    "logistic_regression": {
      "max_iter": 2000,
      "class_weight": "balanced",
      "solver": "saga",
      "C": 10.0,
      "random_state": 42,
      "n_jobs": -1,
      "tol": 0.0001
    },
    "tfidf_word": {
      "ngram_range": [1, 3],
      "lowercase": true,
      "sublinear_tf": true,
      "min_df": 1,
      "max_df": 0.95
    },
    "tfidf_char": {
      "analyzer": "char_wb",
      "ngram_range": [2, 5],
      "lowercase": true,
      "sublinear_tf": true,
      "min_df": 1,
      "max_df": 0.95
    }
  },
  "defaults": {
    "exam_type": "mid_semester"
  },
  "limits": {
    "max_query_chars": 4000
  },
  "llm_defaults": {
    "provider": "ollama",
    "ollama_model": "llama2",
    "openai_model": "gpt-3.5-turbo"
  },
  "llm": {
    "ollama_base_url": "http://localhost:11434",
    "ollama_generate_path": "/api/generate",
    "ollama_tags_path": "/api/tags",
    "max_tokens": 200,
    "temperature": 0.7,
    "request_timeout_seconds": 30,
    "ollama_health_timeout_seconds": 5
  }
}
