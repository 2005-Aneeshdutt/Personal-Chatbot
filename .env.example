# Copy to .env and fill in (never commit .env)
# cp .env.example .env

# OpenAI (optional — only if LLM provider is openai)
OPENAI_API_KEY=

# Optional: custom config path
# CHATBOT_CONFIG=config/app_config.json

# Ollama (optional overrides — defaults are in config/app_config.json)
# OLLAMA_BASE_URL=http://localhost:11434

# Admin panel (see admin.py)
# ADMIN_PASSWORD=change-me
